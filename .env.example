# Copier en `.env` (chargé par mise) et compléter. Toutes les variables du
# projet sont préfixées LIBREJUSTICE_. Aucune valeur réelle ici.

# --- Postgres ---
LIBREJUSTICE_PG_PASSWORD=change_me
LIBREJUSTICE_DB_URL=postgresql://librejustice@127.0.0.1:5432/librejustice

# --- Runtime : données d'ingest hors repo, chemin absolu ---
LIBREJUSTICE_STATE_DIR=${HOME}/.local/share/librejustice

# --- API / serveur ---
LIBREJUSTICE_API_DEPLOYMENT_ENVIRONMENT=dev
LIBREJUSTICE_API_BIND_PORT=8300
LIBREJUSTICE_API_PUBLIC_BASE_URL=http://localhost:8300
LIBREJUSTICE_WEB_PORT=8500
# Vérif de propriété du domaine pour le catalogue d'apps ChatGPT
# (/.well-known/openai-apps-challenge, text/plain). Absent → 404.
# LIBREJUSTICE_API_OPENAI_APPS_CHALLENGE_TOKEN=

# --- Embedding (backend d'inférence) ---
LIBREJUSTICE_EMBED_BACKEND=auto
# LIBREJUSTICE_EMBED_URL=http://localhost:8400/v1/embeddings
# LIBREJUSTICE_EMBED_API_KEY=

# --- Sources PISTE (Légifrance + Judilibre) — requis pour l'ingestion ---
# LIBREJUSTICE_PISTE_CLIENT_ID=
# LIBREJUSTICE_PISTE_CLIENT_SECRET=
# LIBREJUSTICE_PISTE_API_KEY=
# LIBREJUSTICE_PISTE_SECRET=

# --- Résumé / rerank (optionnel) ---
# LIBREJUSTICE_MISTRAL_API_KEYS=key1,key2

# --- Observabilité (optionnel) ---
LIBREJUSTICE_OTEL_ENDPOINT=http://localhost:4318
