# LibreJustice ingest. The steps are defined in `apps/lj-ingest/src/chain.rs`: each has
# its watchdog, a failure does not stop the next ones, and the chain exits non-zero on
# `chain_failed`.

# What a notice's links serve, sampled, outside the chain.
30 2 * * * cd /app && lj-ingest annonces-sonder-liens --par-moteur 8

# The disposable mail domains.
0 12 * * * cd /app && lj-ingest disposable-domains

# The prefectures' recueils, beside the chain, one run at a time under an advisory lock.
0 3 * * * cd /app && lj-ingest raa --minutes 230

0 3 * * 1-6 cd /app && lj-ingest chain daily

# The daily chain then the weekly maintenance, in one process; the chain lock keeps two
# chains from overlapping.
0 3 * * 0 cd /app && lj-ingest chain weekly
