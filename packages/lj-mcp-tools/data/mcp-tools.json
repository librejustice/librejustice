            ],
            "default": null,
            "description": "Parts searched, all when absent: headnote (the court's sommaire or analyse), judgment (the decision without its annexes), annexes (the moyens annexés of Cour de cassation judgments)."
          },
          "seat": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 60,
                  "type": "string"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Restrict to one or more seats, as a dotted path from the legal order down to the room: \"FR\" (an order), \"FR.CA\" (a type), \"FR.CA.PARIS\" (a court), \"FR.CC.C1_CIVILE\", \"FR.CA.PARIS.P5.C3\", \"FR.TJ.PARIS.REFERES\" (a room), \"EU.CJUE\", \"INTL.CEDH\". A path matches itself and everything below it, so start at the order and go deeper. Types: TJ (tribunal judiciaire), CA (cour d'appel), CC (Cour de cassation), TCOM (tribunal des activités économiques), CPH (conseil de prud'hommes), TA (tribunal administratif), CAA (cour administrative d'appel), CE (Conseil d'État), CNDA (asylum), CONSTIT (Conseil constitutionnel), TC (Tribunal des conflits), CNIL, DDD, CEDH and CJUE. Take the paths from facets.seat."
          },
          "solution": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "REJET",
                    "IRRECEVABILITE",
                    "DESISTEMENT",
                    "NON_LIEU_A_STATUER",
